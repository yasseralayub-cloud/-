{
  "entities": {
    "Category": {
      "title": "Category",
      "description": "Menu category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "labelAr": { "type": "string" },
        "icon": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["id", "label", "labelAr", "icon"]
    },
    "MenuItem": {
      "title": "MenuItem",
      "description": "Menu item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "nameAr": { "type": "string" },
        "description": { "type": "string" },
        "descriptionAr": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "image": { "type": "string" },
        "calories": { "type": "number" },
        "isPopular": { "type": "boolean" }
      },
      "required": ["id", "name", "nameAr", "description", "descriptionAr", "price", "category", "image"]
    },
    "Offer": {
      "title": "Offer",
      "description": "Special promotion banner with countdown timer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "titleAr": { "type": "string" },
        "subtitle": { "type": "string" },
        "subtitleAr": { "type": "string" },
        "imageUrl": { "type": "string" },
        "badge": { "type": "string" },
        "badgeAr": { "type": "string" },
        "targetDate": { "type": "string" },
        "isActive": { "type": "boolean" },
        "order": { "type": "number" },
        "ctaText": { "type": "string" },
        "ctaTextAr": { "type": "string" },
        "ctaLink": { "type": "string" }
      },
      "required": ["id", "titleAr", "imageUrl", "targetDate", "isActive"]
    }
  },
  "firestore": {
    "categories": {
      "schema": "Category",
      "description": "Menu categories collection"
    },
    "menuItems": {
      "schema": "MenuItem",
      "description": "Menu items collection"
    },
    "offers": {
      "schema": "Offer",
      "description": "Promotional offers collection"
    }
  }
}
